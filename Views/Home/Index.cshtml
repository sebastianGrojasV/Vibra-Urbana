@{
    ViewData["Title"] = "Inicio";
}

<section class="vu-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h1>Vibra Urbana</h1>
                <p class="vu-lead">
                    Moda urbana seleccionada para el día a día. Explora prendas disponibles y encuentra tu siguiente pieza favorita.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-dark" asp-controller="Catalogo" asp-action="Index">Ver catálogo</a>
                    <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Login">Acceso interno</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="vu-hero-visual" aria-label="Identidad visual Vibra Urbana">
                    <img src="~/img/logo-vibra-urbana.jpeg" alt="Logo Vibra Urbana" />
                    <div>
                        <strong>Estilo Vibra Urbana</strong>
                        <span>Prendas, colores y cortes pensados para moverse con la ciudad.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
