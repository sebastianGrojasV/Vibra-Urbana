@{
    ViewData["Title"] = "Inicio";
}

<section class="vu-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <p class="vu-eyebrow">Sistema comercial</p>
                <h1>Vibra Urbana</h1>
                <p class="vu-lead">
                    Base ASP.NET Core MVC para gestionar la operación comercial de la tienda de ropa.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-dark" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    <a class="btn btn-outline-dark" asp-controller="Admin" asp-action="Index">Panel administrativo</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="vu-status-panel">
                    <span class="badge text-bg-light">Sprint 1</span>
                    <h2>Estructura base MVC</h2>
                    <p>Proyecto preparado con controladores, vistas, servicios, repositorios, modelos y archivos estáticos.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="vu-module">
                <h2>Catálogo</h2>
                <p>Espacio reservado para productos, inventario y pedidos.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="vu-module">
                <h2>Ventas</h2>
                <p>Base lista para ventas, facturación y carrito en siguientes tareas.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="vu-module">
                <h2>Reportes</h2>
                <p>Navegacion inicial preparada para analítica administrativa futura.</p>
            </div>
        </div>
    </div>
</section>
