@model VibraUrbana.ViewModels.ReporteInventarioViewModel

@{
    ViewData["Title"] = "Reporte de inventario";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            @await Html.PartialAsync("_Sidebar")

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Análisis de existencias</p>
                        <h1>Reporte de inventario</h1>
                        <p>Consulta la disponibilidad actual y detecta productos que requieren reposición.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" asp-controller="Reporte" asp-action="Ventas">
                            Reporte de ventas
                        </a>
                        <a class="btn btn-outline-primary" asp-controller="Inventario" asp-action="Index">
                            Ver inventario
                        </a>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="vu-dashboard-card h-100">
                            <span class="vu-card-label">Productos encontrados</span>
                            <strong class="vu-card-value">@Model.TotalProductos</strong>
                            <span class="text-muted small">Según los filtros aplicados</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="vu-dashboard-card h-100">
                            <span class="vu-card-label">Unidades disponibles</span>
                            <strong class="vu-card-value">@Model.TotalUnidades</strong>
                            <span class="text-muted small">Existencias registradas</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="vu-dashboard-card h-100">
                            <span class="vu-card-label">Productos con stock bajo</span>
                            <strong class="vu-card-value">@Model.ProductosStockBajo</strong>
                            <span class="text-muted small">Requieren seguimiento</span>
                        </div>
                    </div>
                </div>

                <div class="vu-panel mb-4">
                    <form asp-controller="Reporte" asp-action="Index" method="get" class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="categoriaId">Categoría</label>
                            <select id="categoriaId" name="categoriaId" asp-items="Model.Categorias" class="form-select">
                                <option value="">Todas las categorías</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="estadoStock">Estado de stock</label>
                            <select id="estadoStock" name="estadoStock" class="form-select">
                                <option value="">Todos los estados</option>
                                <option value="@VibraUrbana.ViewModels.ReporteInventarioViewModel.EstadoStockDisponible"
                                        selected="@(Model.EstadoStock == VibraUrbana.ViewModels.ReporteInventarioViewModel.EstadoStockDisponible ? "selected" : null)">
                                    Disponible
                                </option>
                                <option value="@VibraUrbana.ViewModels.ReporteInventarioViewModel.EstadoStockBajo"
                                        selected="@(Model.EstadoStock == VibraUrbana.ViewModels.ReporteInventarioViewModel.EstadoStockBajo ? "selected" : null)">
                                    Stock bajo
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex flex-wrap gap-2">
                            <button class="btn btn-primary" type="submit">
                                Generar reporte
                            </button>
                            <a class="btn btn-outline-secondary" asp-controller="Reporte" asp-action="Index">
                                Limpiar
                            </a>
                        </div>
                    </form>
                </div>

                <div class="vu-panel">
                    @if (!Model.Inventario.Any())
                    {
                        <div class="alert alert-info mb-0" role="status">
                            No existen productos en inventario con los filtros seleccionados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle vu-data-table">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Categoría</th>
                                        <th>Talla</th>
                                        <th>Color</th>
                                        <th>Disponible</th>
                                        <th>Stock mínimo</th>
                                        <th>Estado de stock</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Inventario)
                                    {
                                        <tr class="@(item.StockBajo ? "vu-stock-low-row" : string.Empty)">
                                            <td>
                                                <strong>@item.Producto</strong>
                                                <div class="text-muted small">
                                                    @(item.Activo ? "Producto activo" : "Producto inactivo")
                                                </div>
                                            </td>
                                            <td>@item.Categoria</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Talla) ? "Sin talla" : item.Talla)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Color) ? "Sin color" : item.Color)</td>
                                            <td>@item.CantidadDisponible</td>
                                            <td>@item.StockMinimo</td>
                                            <td>
                                                @if (item.StockBajo)
                                                {
                                                    <span class="badge bg-warning text-dark">Stock bajo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Disponible</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

