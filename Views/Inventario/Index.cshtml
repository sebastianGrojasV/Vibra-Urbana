@{
    ViewData["Title"] = "Inventario";
}

<section class="vu-module-placeholder-page">
    <div class="container">
        <div class="vu-module-placeholder">
            <span class="vu-module-placeholder-icon" data-vu-module-icon="inventario"></span>
            <p class="vu-eyebrow">Módulo en preparación</p>
            <h1>Inventario</h1>
            <p>Esta vista soportará existencias, stock mínimo y movimientos de entrada o salida de productos.</p>
            <div class="vu-placeholder-actions">
                <a class="btn btn-primary" asp-controller="Admin" asp-action="Index">Volver al panel</a>
                <a class="btn btn-outline-primary" asp-controller="Producto" asp-action="Index">Ver productos</a>
            </div>
        </div>
    </div>
</section>
