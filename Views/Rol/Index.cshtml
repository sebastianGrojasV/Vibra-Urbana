@model IEnumerable<VibraUrbana.Models.Rol>

@{
    ViewData["Title"] = "Lista de Roles";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <!--  Sidebar -->
            <aside class="col-lg-3 col-xl-2 vu-admin-sidebar">
                <div class="vu-sidebar-brand">Vibra Urbana</div>
                <nav class="vu-sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index">Panel inicial</a>
                    <a asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <a class="active" asp-controller="Rol" asp-action="Index">Roles</a>
                    <a asp-controller="Cliente" asp-action="Index">Clientes</a>
                    <a asp-controller="Producto" asp-action="Index">Productos</a>
                    <a asp-controller="Inventario" asp-action="Index">Inventario</a>
                    <a asp-controller="Venta" asp-action="Index">Ventas</a>
                    <a asp-controller="Factura" asp-action="Index">Facturación</a>
                    <a asp-controller="Reporte" asp-action="Index">Reportes</a>
                    <a asp-controller="Pedido" asp-action="Index">Pedidos</a>
                </nav>
            </aside>

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Lista de Roles</h1>
                        <p>Consulta y administra los roles disponibles en el sistema.</p>
                    </div>
                    <a asp-action="Create" class="btn btn-lg btn-success d-flex align-items-center gap-2 shadow">
                        <i class="bi bi-person-plus-fill"></i>
                        Crear Rol
                    </a>
                </div>

                <style>
                    th {
                        color: purple; /* morado para las cabeceras */
                        font-weight: bold;
                    }
                </style>

                <!--  Toast de confirmación -->
                @if (TempData["RolCreado"] != null)
                {
                    <div class="toast-container position-fixed top-0 end-0 p-3">
                        <div class="toast align-items-center text-bg-success border-0" role="alert">
                            <div class="d-flex">
                                <div class="toast-body">
                                    @TempData["RolCreado"]
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                            </div>
                        </div>
                    </div>
                }

                <!--  Toast de confirmación -->
                @if (TempData["RolEliminado"] != null)
                {
                    <div class="toast-container position-fixed bottom-0 end-0 p-3">
                        <div class="toast align-items-center text-bg-success border-0" role="alert">
                            <div class="d-flex">
                                <div class="toast-body">
                                    @TempData["RolEliminado"]
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                            </div>
                        </div>
                    </div>
                }

                <!--  Toast de error -->
                @if (TempData["RolError"] != null)
                {
                    <div class="toast-container position-fixed bottom-0 end-0 p-3">
                        <div class="toast align-items-center text-bg-danger border-0" role="alert">
                            <div class="d-flex">
                                <div class="toast-body">
                                    @TempData["RolError"]
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                            </div>
                        </div>
                    </div>
                }

                @if (TempData["RolActivado"] != null)
                {
                    <div class="toast-container position-fixed bottom-0 end-0 p-3">
                        <div class="toast align-items-center text-bg-success border-0" role="alert">
                            <div class="d-flex">
                                <div class="toast-body">
                                    @TempData["RolActivado"]
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                            </div>
                        </div>
                    </div>
                }


                <!-- Tabla dentro de un card -->
                <div class="card shadow-sm">
                    <div class="card-body">
                        <table id="tablaRoles" class="table table-hover table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Id</th>
                                    <th>Rol</th>
                                    <th>Descripción</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rol in Model)
                                {
                                    <tr>
                                        <td>@rol.Id</td>
                                        <td>@rol.Nombre</td>
                                        <td>@rol.Descripcion</td>
                                        <td class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@rol.Id" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> Detalles
                                            </a>

                                            <!--  Botón Desactivar -->
                                            @if (rol.Activo)
                                            {
                                                <a asp-action="Delete" asp-route-id="@rol.Id" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-x-circle"></i> Desactivar
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactivo</span>
                                            }
                                            @if (!rol.Activo)
                                            {
                                                <form asp-action="Activar" asp-route-id="@rol.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-check-circle"></i> Activar
                                                    </button>
                                                </form>
                                            }

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaRoles').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                responsive: true,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                }
            });

            // 🔹 Inicializar Toast automáticamente
            var toastElList = [].slice.call(document.querySelectorAll('.toast'))
            toastElList.map(function (toastEl) {
                var toast = new bootstrap.Toast(toastEl, { delay: 3000, autohide: true })
                toast.show()

            });
        });
    </script>
}