@model IReadOnlyList<VibraUrbana.ViewModels.RolListadoItemViewModel>

@{
    ViewData["Title"] = "Roles";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <aside class="col-lg-3 col-xl-2 vu-admin-sidebar">
                <div class="vu-sidebar-brand">Vibra Urbana</div>
                <nav class="vu-sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index">Panel inicial</a>
                    <a asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <a class="active" asp-controller="Rol" asp-action="Index">Roles</a>
                    <a asp-controller="Cliente" asp-action="Index">Clientes</a>
                    <a asp-controller="Producto" asp-action="Index">Productos</a>
                    <a asp-controller="Inventario" asp-action="Index">Inventario</a>
                    <a asp-controller="Venta" asp-action="Index">Ventas</a>
                    <a asp-controller="Factura" asp-action="Index">Facturación</a>
                    <a asp-controller="Reporte" asp-action="Index">Reportes</a>
                    <a asp-controller="Pedido" asp-action="Index">Pedidos</a>
                </nav>
            </aside>

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Roles</h1>
                        <p>Consulta y crea roles disponibles para asignar a usuarios internos.</p>
                    </div>
                    <a class="btn btn-primary" asp-controller="Rol" asp-action="Create">Crear rol</a>
                </div>

                <div class="vu-panel">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            No existen roles registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Descripción</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rol in Model)
                                    {
                                        <tr>
                                            <td>@rol.Nombre</td>
                                            <td>@rol.Descripcion</td>
                                            <td>
                                                @if (rol.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <form asp-controller="Rol" asp-action="CambiarEstado" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input name="id" type="hidden" value="@rol.Id" />
                                                    <input name="active" type="hidden" value="@(!rol.Activo).ToString().ToLowerInvariant()" />
                                                    <button class="btn btn-sm @(rol.Activo ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                                        @(rol.Activo ? "Desactivar" : "Activar")
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>