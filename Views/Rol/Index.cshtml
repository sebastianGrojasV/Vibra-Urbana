@model IReadOnlyList<VibraUrbana.ViewModels.RolListadoItemViewModel>

@{
    ViewData["Title"] = "Roles";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            @await Html.PartialAsync("_Sidebar")

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Roles</h1>
                        <p>Consulta y crea roles disponibles para asignar a usuarios internos.</p>
                    </div>
                    <a class="btn btn-primary" asp-controller="Rol" asp-action="Create">Crear rol</a>
                </div>

                <div class="vu-panel">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            No existen roles registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle vu-data-table">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Descripción</th>
                                        <th>Estado</th>
                                        <th class="text-end vu-actions-column">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rol in Model)
                                    {
                                        <tr>
                                            <td>@rol.Nombre</td>
                                            <td>@rol.Descripcion</td>
                                            <td>
                                                @if (rol.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="vu-actions">
                                                    <a class="btn btn-sm vu-icon-btn vu-icon-edit" asp-controller="Rol" asp-action="Edit" asp-route-id="@rol.Id" title="Editar" aria-label="Editar rol">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"></path></svg>
                                                    </a>
                                                    <form asp-controller="Rol"
                                                          asp-action="ConfirmarCambiarEstado"
                                                          method="post"
                                                          class="d-inline"
                                                          data-vu-confirm
                                                          data-vu-confirm-title="@(rol.Activo ? "Desactivar rol" : "Activar rol")"
                                                          data-vu-confirm-message="@(rol.Activo ? $"¿Deseas desactivar el rol {rol.Nombre}?" : $"¿Deseas activar el rol {rol.Nombre}?")"
                                                          data-vu-confirm-action="@(rol.Activo ? "Desactivar" : "Activar")">
                                                        @Html.AntiForgeryToken()
                                                        <input name="id" type="hidden" value="@rol.Id" />
                                                        <input name="active" type="hidden" value="@(rol.Activo ? "false" : "true")" />
                                                        <button class="btn btn-sm vu-icon-btn @(rol.Activo ? "vu-icon-disable" : "vu-icon-enable")" type="submit" title="@(rol.Activo ? "Desactivar" : "Activar")" aria-label="@(rol.Activo ? "Desactivar rol" : "Activar rol")">
                                                            @if (rol.Activo)
                                                            {
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.4 6.6a9 9 0 1 1-12.8 0"></path><path d="M12 2v10"></path></svg>
                                                            }
                                                            else
                                                            {
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                                                            }
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

