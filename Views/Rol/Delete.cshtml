@model VibraUrbana.Models.Rol

@{
    ViewData["Title"] = "Desactivar Rol";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <aside class="col-lg-3 col-xl-2 vu-admin-sidebar">
                <div class="vu-sidebar-brand">Vibra Urbana</div>
                <nav class="vu-sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index">Panel inicial</a>
                    <a asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <a class="active" asp-controller="Rol" asp-action="Index">Roles</a>
                    <!-- resto del menú -->
                </nav>
            </aside>

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Desactivar Rol</h1>
                        <p>Confirma si deseas desactivar este rol. No se eliminará físicamente, solo quedará inactivo.</p>
                    </div>
                    <a class="btn btn-outline-primary" asp-action="Index">Volver al listado</a>
                </div>

                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">Id</dt>
                            <dd class="col-sm-9">@Model.Id</dd>

                            <dt class="col-sm-3">Nombre</dt>
                            <dd class="col-sm-9">@Model.Nombre</dd>

                            <dt class="col-sm-3">Descripción</dt>
                            <dd class="col-sm-9">@Model.Descripcion</dd>
                        </dl>

                        <form asp-action="DeleteConfirmed" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirmar desactivación
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>