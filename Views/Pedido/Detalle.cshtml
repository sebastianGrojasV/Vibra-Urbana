@model VibraUrbana.ViewModels.PedidoDetalleViewModel

@{
    ViewData["Title"] = $"Detalle {Model.Codigo}";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            @await Html.PartialAsync("_Sidebar")

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">@Model.Codigo</p>
                        <h1>Detalle de pedido</h1>
                        <p>Información completa del pedido web, cliente, comprobante y productos solicitados.</p>
                    </div>
                    <a class="btn btn-outline-primary" asp-controller="Pedido" asp-action="Index">Volver</a>
                </div>

                <div class="vu-panel">
                    <div class="vu-order-admin-summary">
                        <div>
                            <span>Fecha del pedido</span>
                            <strong>@Model.FechaPedido.ToString("dd/MM/yyyy hh:mm tt")</strong>
                        </div>
                        <div>
                            <span>Estado</span>
                            <strong><span class="badge @EstadoBadge(Model.Estado)">@Model.Estado</span></strong>
                        </div>
                        <div>
                            <span>Método de pago</span>
                            <strong>@Model.MetodoPago</strong>
                        </div>
                        <div>
                            <span>Total</span>
                            <strong>@Model.Total.ToString("C0")</strong>
                        </div>
                    </div>

                    <div class="vu-order-admin-grid">
                        <section class="vu-order-admin-card">
                            <h2>Cliente</h2>
                            <dl>
                                <div>
                                    <dt>Nombre</dt>
                                    <dd>@Model.NombreCliente</dd>
                                </div>
                                <div>
                                    <dt>Teléfono</dt>
                                    <dd>@Model.Telefono</dd>
                                </div>
                                <div>
                                    <dt>Correo</dt>
                                    <dd>@Model.Correo</dd>
                                </div>
                                <div>
                                    <dt>Dirección</dt>
                                    <dd>@Model.DireccionEntrega</dd>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.Observacion))
                                {
                                    <div>
                                        <dt>Observación</dt>
                                        <dd>@Model.Observacion</dd>
                                    </div>
                                }
                            </dl>
                        </section>

                        <section class="vu-order-admin-card">
                            <h2>Comprobante</h2>
                            @if (string.IsNullOrWhiteSpace(Model.ReferenciaPago) && string.IsNullOrWhiteSpace(Model.ImagenComprobanteUrl))
                            {
                                <div class="alert alert-info" role="alert">No hay comprobante registrado para este pedido.</div>
                            }
                            else
                            {
                                <dl>
                                    <div>
                                        <dt>Referencia</dt>
                                        <dd>@(string.IsNullOrWhiteSpace(Model.ReferenciaPago) ? "Sin referencia" : Model.ReferenciaPago)</dd>
                                    </div>
                                    <div>
                                        <dt>Estado de verificación</dt>
                                        <dd>@(string.IsNullOrWhiteSpace(Model.EstadoVerificacion) ? "Pendiente" : Model.EstadoVerificacion)</dd>
                                    </div>
                                    @if (Model.FechaComprobante.HasValue)
                                    {
                                        <div>
                                            <dt>Fecha</dt>
                                            <dd>@Model.FechaComprobante.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>
                                        </div>
                                    }
                                </dl>

                                @if (!string.IsNullOrWhiteSpace(Model.ImagenComprobanteUrl))
                                {
                                    <a class="vu-payment-proof" href="@Model.ImagenComprobanteUrl" target="_blank" rel="noopener">
                                        <img src="@Model.ImagenComprobanteUrl" alt="Comprobante de pago del pedido @Model.Codigo" />
                                    </a>
                                }
                            }
                        </section>

                        <section class="vu-order-admin-card vu-delivery-qr-card">
                            <h2>QR de entrega</h2>
                            <div class="vu-delivery-qr">
                                <img src="@Url.Action("QrEntrega", "Pedido", new { id = Model.Id })" alt="Código QR de entrega para @Model.Codigo" />
                                <div>
                                    <strong>@Model.Codigo</strong>
                                    <span>Pega este QR en la caja para que el cliente confirme la recepción al escanearlo.</span>
                                    <div class="vu-delivery-qr-actions">
                                        <a class="btn btn-sm btn-primary" asp-controller="Pedido" asp-action="EtiquetaEntrega" asp-route-id="@Model.Id" target="_blank" rel="noopener">
                                            <svg class="vu-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9V2h12v7"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
                                            Imprimir QR
                                        </a>
                                        <a href="@Url.Action("Seguimiento", "Pedido", new { token = Model.TokenEntrega })" target="_blank" rel="noopener">Abrir seguimiento</a>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="vu-order-admin-card">
                            <h2>Trazabilidad</h2>
                            <ol class="vu-delivery-timeline">
                                <li class="is-complete">
                                    <strong>Pedido recibido</strong>
                                    <span>@Model.FechaPedido.ToString("dd/MM/yyyy hh:mm tt")</span>
                                </li>
                                <li class="@(Model.FechaEnvio.HasValue ? "is-complete" : "")">
                                    <strong>Enviado</strong>
                                    <span>@(Model.FechaEnvio.HasValue ? Model.FechaEnvio.Value.ToString("dd/MM/yyyy hh:mm tt") : "Pendiente")</span>
                                </li>
                                <li class="@(Model.FechaTransito.HasValue ? "is-complete" : "")">
                                    <strong>En tránsito</strong>
                                    <span>@(Model.FechaTransito.HasValue ? Model.FechaTransito.Value.ToString("dd/MM/yyyy hh:mm tt") : "Pendiente")</span>
                                </li>
                                <li class="@(Model.FechaEntrega.HasValue ? "is-complete" : "")">
                                    <strong>Entregado</strong>
                                    <span>@(Model.FechaEntrega.HasValue ? Model.FechaEntrega.Value.ToString("dd/MM/yyyy hh:mm tt") : "Pendiente")</span>
                                </li>
                            </ol>
                        </section>
                    </div>

                    <div class="table-responsive mt-4">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th>Talla</th>
                                    <th>Color</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var producto in Model.Productos)
                                {
                                    <tr>
                                        <td><strong>@producto.Producto</strong></td>
                                        <td>@producto.Categoria</td>
                                        <td>@producto.Talla</td>
                                        <td>@producto.Color</td>
                                        <td class="text-end">@producto.Cantidad</td>
                                        <td class="text-end">@producto.PrecioUnitario.ToString("C0")</td>
                                        <td class="text-end">@producto.Subtotal.ToString("C0")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="6" class="text-end">Subtotal</th>
                                    <th class="text-end">@Model.Subtotal.ToString("C0")</th>
                                </tr>
                                <tr>
                                    <th colspan="6" class="text-end">Descuento</th>
                                    <th class="text-end text-danger">-@Model.Descuento.ToString("C0")</th>
                                </tr>
                                <tr>
                                    <th colspan="6" class="text-end">Impuesto</th>
                                    <th class="text-end">@Model.Impuesto.ToString("C0")</th>
                                </tr>
                                <tr>
                                    <th colspan="6" class="text-end">Total</th>
                                    <th class="text-end text-primary">@Model.Total.ToString("C0")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="vu-order-admin-actions">
                        @if (Model.Estado == "Pendiente de verificación")
                        {
                            <form asp-controller="Pedido" asp-action="CambiarEstado" method="post" data-vu-confirm data-vu-confirm-title="Confirmar pedido" data-vu-confirm-message="El pedido pasará a estado Confirmado." data-vu-confirm-action="Confirmar" data-vu-confirm-observation="true" data-vu-confirm-observation-label="Observación opcional" data-vu-confirm-observation-placeholder="Ejemplo: Pago verificado por SINPE.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PedidoId" value="@Model.Id" />
                                <input type="hidden" name="NuevoEstado" value="Confirmado" />
                                <button class="btn btn-primary" type="submit">Confirmar pedido</button>
                            </form>
                        }

                        @if (Model.Estado is "Pendiente de verificación" or "Confirmado" or "Enviado" or "En tránsito")
                        {
                            <form asp-controller="Pedido" asp-action="CambiarEstado" method="post" data-vu-confirm data-vu-confirm-title="Cancelar pedido" data-vu-confirm-message="El pedido quedará cancelado sin eliminar el historial." data-vu-confirm-action="Cancelar pedido" data-vu-confirm-observation="true" data-vu-confirm-observation-required="true" data-vu-confirm-observation-label="Motivo de cancelación" data-vu-confirm-observation-placeholder="Indica por qué el pedido no procede.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PedidoId" value="@Model.Id" />
                                <input type="hidden" name="NuevoEstado" value="Cancelado" />
                                <button class="btn btn-outline-danger" type="submit">Cancelar pedido</button>
                            </form>
                        }

                        @if (Model.Estado == "Confirmado")
                        {
                            <form asp-controller="Pedido" asp-action="CambiarEstado" method="post" data-vu-confirm data-vu-confirm-title="Marcar como enviado" data-vu-confirm-message="El pedido pasará a estado Enviado." data-vu-confirm-action="Marcar enviado" data-vu-confirm-observation="true" data-vu-confirm-observation-label="Observación opcional" data-vu-confirm-observation-placeholder="Ejemplo: Pedido despachado para entrega.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PedidoId" value="@Model.Id" />
                                <input type="hidden" name="NuevoEstado" value="Enviado" />
                                <button class="btn btn-outline-primary" type="submit">Marcar como enviado</button>
                            </form>
                        }

                        @if (Model.Estado is "Confirmado" or "Enviado")
                        {
                            <form asp-controller="Pedido" asp-action="CambiarEstado" method="post" data-vu-confirm data-vu-confirm-title="Marcar en tránsito" data-vu-confirm-message="El pedido pasará a estado En tránsito." data-vu-confirm-action="Marcar en tránsito" data-vu-confirm-observation="true" data-vu-confirm-observation-label="Observación opcional" data-vu-confirm-observation-placeholder="Ejemplo: Pedido en ruta con mensajería.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PedidoId" value="@Model.Id" />
                                <input type="hidden" name="NuevoEstado" value="En tránsito" />
                                <button class="btn btn-outline-primary" type="submit">Marcar en tránsito</button>
                            </form>
                        }

                        @if (Model.Estado is "Confirmado" or "Enviado" or "En tránsito")
                        {
                            <form asp-controller="Pedido" asp-action="CambiarEstado" method="post" data-vu-confirm data-vu-confirm-title="Marcar como entregado" data-vu-confirm-message="El pedido quedará marcado como Entregado." data-vu-confirm-action="Marcar entregado" data-vu-confirm-observation="true" data-vu-confirm-observation-label="Observación opcional" data-vu-confirm-observation-placeholder="Ejemplo: Entregado en tienda o por mensajería.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PedidoId" value="@Model.Id" />
                                <input type="hidden" name="NuevoEstado" value="Entregado" />
                                <button class="btn btn-outline-primary" type="submit">Marcar como entregado</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@functions {
    private static string EstadoBadge(string estado)
    {
        return estado switch
        {
            "Pendiente de verificación" => "bg-warning text-dark",
            "Confirmado" => "bg-primary",
            "Enviado" => "bg-info text-dark",
            "En tránsito" => "bg-info text-dark",
            "Entregado" => "bg-success",
            "Cancelado" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
