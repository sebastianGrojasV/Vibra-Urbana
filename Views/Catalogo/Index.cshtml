@using System.Globalization
@model VibraUrbana.ViewModels.CatalogoIndexViewModel

@{
    ViewData["Title"] = "Catálogo";
    var precioMinimo = Model.PrecioMinimo?.ToString("0.##", CultureInfo.InvariantCulture);
    var precioMaximo = Model.PrecioMaximo?.ToString("0.##", CultureInfo.InvariantCulture);
}

<section class="vu-catalog-hero">
    <div class="container">
        <div class="vu-catalog-hero-content">
            <p class="vu-eyebrow">Vibra Urbana</p>
            <h1>Moda urbana para moverte a tu ritmo</h1>
            <p>Explora prendas disponibles, precios y estilos pensados para el día a día.</p>
            <div class="vu-catalog-actions">
                <a class="btn btn-dark" href="#productos">Ver catálogo</a>
                <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Login">Acceso interno</a>
            </div>
        </div>

        <div class="vu-catalog-hero-note" aria-label="Resumen del catálogo">
            <strong>@Model.Productos.Count</strong>
            <span>producto@(Model.Productos.Count == 1 ? "" : "s") para consultar</span>
        </div>
    </div>
</section>

<section id="productos" class="vu-catalog-section">
    <div class="container">
        <div class="vu-catalog-toolbar">
            <div class="vu-catalog-heading">
                <div>
                    <h2>Catálogo</h2>
                    <p>Busca por nombre, color, talla, categoría o rango de precio.</p>
                </div>
            </div>

            <form asp-controller="Catalogo" asp-action="Index" method="get" class="vu-catalog-filters" data-vu-catalog-form>
                <div class="vu-catalog-search-field">
                    <label class="form-label" for="busqueda">Buscar</label>
                    <input class="form-control" id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Camisa, negro, M..." />
                </div>
                <div>
                    <label class="form-label" for="categoriaId">Categoría</label>
                    <select class="form-select" id="categoriaId" name="categoriaId">
                        <option value="">Todas</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Value" selected="@categoria.Selected">@categoria.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="talla">Talla</label>
                    <select class="form-select" id="talla" name="talla">
                        <option value="">Todas</option>
                        @foreach (var talla in Model.Tallas)
                        {
                            <option value="@talla.Value" selected="@talla.Selected">@talla.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="color">Color</label>
                    <select class="form-select" id="color" name="color">
                        <option value="">Todos</option>
                        @foreach (var color in Model.Colores)
                        {
                            <option value="@color.Value" selected="@color.Selected">@color.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="precioMinimo">Desde</label>
                    <input class="form-control" id="precioMinimo" name="precioMinimo" type="number" min="0" step="100" value="@precioMinimo" placeholder="₡0" />
                </div>
                <div>
                    <label class="form-label" for="precioMaximo">Hasta</label>
                    <input class="form-control" id="precioMaximo" name="precioMaximo" type="number" min="0" step="100" value="@precioMaximo" placeholder="₡50 000" />
                </div>
                <div class="vu-catalog-filter-actions">
                    <button class="btn btn-primary" type="submit">Filtrar</button>
                    <a class="btn btn-outline-secondary" asp-controller="Catalogo" asp-action="Index" data-vu-catalog-clear>Limpiar</a>
                </div>
            </form>
        </div>

        <div data-vu-catalog-results aria-live="polite">
            @await Html.PartialAsync("_Productos", Model)
        </div>
    </div>
</section>
