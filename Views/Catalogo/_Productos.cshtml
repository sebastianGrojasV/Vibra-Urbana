@model VibraUrbana.ViewModels.CatalogoIndexViewModel

<div class="vu-catalog-results-summary">
    <span>@Model.Productos.Count resultado@(Model.Productos.Count == 1 ? "" : "s") encontrado@(Model.Productos.Count == 1 ? "" : "s")</span>
</div>

@if (!Model.Productos.Any())
{
    <div class="vu-catalog-empty">
        <strong>No encontramos productos con esos filtros</strong>
        <span>Prueba con otra categoría, talla, color o rango de precio.</span>
    </div>
}
else
{
    <div class="vu-catalog-grid">
        @foreach (var producto in Model.Productos)
        {
            var fallback = string.IsNullOrWhiteSpace(producto.Nombre)
                ? "VU"
                : producto.Nombre[..Math.Min(2, producto.Nombre.Length)].ToUpperInvariant();

            <article class="vu-catalog-card @(producto.Disponible ? "" : "is-sold-out")">
                <div class="vu-catalog-media">
                    @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                    {
                        <img src="@producto.ImagenUrl" alt="@producto.Nombre" loading="lazy" />
                    }
                    else
                    {
                        <div class="vu-catalog-image-fallback" aria-label="@producto.Nombre">
                            <span>@fallback</span>
                            <small>@producto.Categoria</small>
                        </div>
                    }

                    <span class="vu-catalog-status @(producto.Disponible ? "is-available" : "is-empty")">
                        @(producto.Disponible ? "Disponible" : "Agotado")
                    </span>
                </div>

                <div class="vu-catalog-body">
                    <div class="vu-catalog-card-header">
                        <span>@producto.Categoria</span>
                        <strong>@producto.Precio.ToString("C0")</strong>
                    </div>
                    <h3>@producto.Nombre</h3>
                    @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                    {
                        <p>@producto.Descripcion</p>
                    }
                    <div class="vu-catalog-meta">
                        <span>Talla @producto.Talla</span>
                        <span>@producto.Color</span>
                        <span>@(producto.Disponible ? $"{producto.CantidadDisponible} disponible(s)" : "Sin stock")</span>
                    </div>
                </div>
            </article>
        }
    </div>
}
