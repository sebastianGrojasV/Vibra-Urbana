@{
    ViewData["Title"] = "Carrito";
}

<section class="vu-cart-page">
    <div class="container">
        <div class="vu-cart-header">
            <div>
                <p class="vu-eyebrow">Compra en línea</p>
                <h1>Carrito de compras</h1>
                <p>Revisa tus prendas, ajusta cantidades y continúa al formulario para confirmar tu pedido.</p>
            </div>
            <a class="btn btn-outline-dark" asp-controller="Catalogo" asp-action="Index">Seguir comprando</a>
        </div>

        <div class="vu-cart-layout">
            <section class="vu-cart-panel">
                <div class="vu-cart-panel-header">
                    <h2>Productos seleccionados</h2>
                    <span data-vu-cart-count-label>0 artículos</span>
                </div>

                <div class="vu-cart-empty" data-vu-cart-empty hidden>
                    <strong>Tu carrito está vacío</strong>
                    <span>Explora el catálogo y agrega prendas para preparar tu pedido.</span>
                    <a class="btn btn-primary" asp-controller="Catalogo" asp-action="Index">Ver catálogo</a>
                </div>

                <div class="vu-cart-items" data-vu-cart-items></div>
            </section>

            <aside class="vu-cart-summary">
                <h2>Resumen del pedido</h2>
                <dl>
                    <div>
                        <dt>Subtotal</dt>
                        <dd data-vu-cart-subtotal>₡0</dd>
                    </div>
                    <div>
                        <dt>Impuesto estimado</dt>
                        <dd data-vu-cart-tax>₡0</dd>
                    </div>
                    <div class="vu-cart-total-row">
                        <dt>Total</dt>
                        <dd data-vu-cart-total>₡0</dd>
                    </div>
                </dl>

                <div class="vu-order-warning mb-3" data-vu-checkout-message hidden></div>
                <button class="btn btn-primary w-100" type="button" data-vu-checkout>Finalizar compra</button>
            </aside>
        </div>
    </div>
</section>
