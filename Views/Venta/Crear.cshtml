@model VibraUrbana.ViewModels.CrearVentaViewModel

@{
    ViewData["Title"] = "Registrar Nueva Venta";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <!-- Sidebar -->
            @await Html.PartialAsync("_Sidebar")

            <!-- Main Content -->
            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header d-flex justify-content-between align-items-center">
                    <div>
                        <p class="vu-eyebrow">Módulo de ventas</p>
                        <h1>Registrar Nueva Venta</h1>
                        <p>Crea una nueva transacción comercial seleccionando cliente, productos y método de pago.</p>
                    </div>
                    <a class="btn btn-outline-secondary" asp-controller="Venta" asp-action="Index">Volver al historial</a>
                </div>

                <form id="antiForgeryForm" hidden>
                    @Html.AntiForgeryToken()
                </form>

                <div id="ventaNotice" class="vu-sale-notice d-none" role="alert" aria-live="polite"></div>

                <div class="row">
                    <!-- Formulario de venta y carrito -->
                    <div class="col-lg-8">
                        <!-- Card 1: Datos Generales -->
                        <div class="vu-panel vu-sale-panel mb-4">
                            <div class="vu-sale-panel-header">
                                <span class="align-middle">Datos Generales de la Venta</span>
                            </div>
                            <div class="vu-sale-panel-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="clienteSearchInput" class="form-label font-weight-bold">Cliente <span class="text-danger">*</span></label>
                                        <div class="vu-sale-search">
                                            <input type="search"
                                                   id="clienteSearchInput"
                                                   class="form-control"
                                                   placeholder="Buscar por nombre o identificación"
                                                   autocomplete="off" />
                                            <input type="hidden" id="clienteIdInput" value="" />
                                            <div id="clienteResults" class="vu-sale-search-results d-none" role="listbox"></div>
                                        </div>
                                        <small id="clienteSeleccionado" class="vu-sale-selected-client text-muted">Sin cliente seleccionado.</small>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="metodoPagoSelect" class="form-label font-weight-bold">Método de Pago <span class="text-danger">*</span></label>
                                        <select id="metodoPagoSelect" class="form-select" required>
                                            <option value="">-- Seleccione el método --</option>
                                            @foreach (var metodo in Model.MetodosPago)
                                            {
                                                <option value="@metodo.Id">@metodo.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <label for="observacionText" class="form-label">Observaciones</label>
                                        <textarea id="observacionText" class="form-control" rows="2" placeholder="Notas adicionales sobre la venta..." maxlength="500"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: Seleccion de Productos -->
                        <div class="vu-panel vu-sale-panel mb-4">
                            <div class="vu-sale-panel-header">
                                <span>Agregar Productos</span>
                            </div>
                            <div class="vu-sale-panel-body">
                                <div class="row align-items-end">
                                    <div class="col-md-6 mb-3">
                                        <label for="productoSelect" class="form-label font-weight-bold">Producto</label>
                                        <select id="productoSelect" class="form-select">
                                            <option value="">-- Buscar / Seleccionar producto --</option>
                                            @foreach (var prod in Model.Productos)
                                            {
                                                <option value="@prod.Id">@prod.Nombre (Talla: @prod.Talla | Col: @prod.Color) - @prod.Precio.ToString("C2")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label for="cantidadInput" class="form-label font-weight-bold">Cantidad</label>
                                        <input type="number" id="cantidadInput" class="form-control" min="1" value="1" disabled />
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <button type="button" id="btnAgregarProducto" class="btn btn-primary w-100" disabled>
                                            Agregar Item
                                        </button>
                                    </div>
                                </div>

                                <!-- Detalles del producto seleccionado -->
                                <div id="detalleProductoSeleccionado" class="vu-sale-product-summary d-none" role="status">
                                    <div class="row text-center text-md-start">
                                        <div class="col-md-4"><strong>Precio Unitario:</strong> <span id="lblPrecioUnitario">₡0.00</span></div>
                                        <div class="col-md-4"><strong>Stock Disponible:</strong> <span id="lblStockDisponible" class="badge vu-stock-badge vu-stock-ok">0</span></div>
                                        <div class="col-md-4"><strong>Categoría:</strong> <span id="lblCategoria">N/A</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card 3: Tabla de Detalles -->
                        <div class="vu-panel vu-sale-panel mb-4">
                            <div class="vu-sale-panel-header">
                                <span>Detalle de la Venta</span>
                            </div>
                            <div class="vu-sale-panel-body p-0">
                                <div class="table-responsive">
                                    <table id="tablaDetalles" class="table table-hover align-middle mb-0 vu-sale-detail-table">
                                        <thead>
                                            <tr>
                                                <th class="ps-3">Producto</th>
                                                <th class="text-center">Talla/Color</th>
                                                <th class="text-end">Precio Unit.</th>
                                                <th class="text-center" style="width: 150px;">Cantidad</th>
                                                <th class="text-end">Subtotal</th>
                                                <th class="text-center" style="width: 80px;">Quitar</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr id="filaVacia">
                                                <td colspan="6" class="text-center py-4 text-muted">
                                                    No se han agregado productos a la venta todavía.
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Panel de Totales y Confirmacion -->
                    <div class="col-lg-4">
                        <div class="vu-panel vu-sale-summary sticky-top" style="top: 80px; z-index: 100;">
                            <div class="vu-sale-panel-header text-center py-3">
                                <h5 class="mb-0">Resumen y Cómputo</h5>
                            </div>
                            <div class="vu-sale-panel-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal:</span>
                                    <strong id="lblResumenSubtotal">₡0.00</strong>
                                </div>

                                <div class="mb-3">
                                    <label for="descuentoInput" class="form-label text-muted mb-1">Descuento Directo (₡):</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">₡</span>
                                        <input type="number" id="descuentoInput" class="form-control text-end" min="0" value="0" step="100" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Monto Gravable:</span>
                                    <span id="lblResumenGravable">₡0.00</span>
                                </div>

                                <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                    <span class="text-muted">Impuesto (IVA 13%):</span>
                                    <strong id="lblResumenImpuesto">₡0.00</strong>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <span class="h5 mb-0 text-dark">Total Neto:</span>
                                    <span class="h4 mb-0 text-primary font-weight-bold" id="lblResumenTotal">₡0.00</span>
                                </div>

                                <div id="errorSubmitAlert" class="vu-sale-notice vu-sale-notice-danger d-none py-2" role="alert"></div>

                                <button type="button" id="btnGuardarVenta" class="btn btn-primary btn-lg w-100 py-3 rounded-custom shadow-soft" disabled>
                                    Registrar Venta
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Serializacion de productos y clientes para uso interactivo en el cliente
        const productosDisponibles = @Html.Raw(Json.Serialize(Model.Productos));
        const clientesDisponibles = @Html.Raw(Json.Serialize(Model.Clientes))
            .filter(c => (c.identificacion ?? c.Identificacion) !== "000000000");

        // Carrito en memoria
        let carrito = [];

        // Elementos DOM
        const productoSelect = document.getElementById("productoSelect");
        const cantidadInput = document.getElementById("cantidadInput");
        const btnAgregarProducto = document.getElementById("btnAgregarProducto");
        const detalleProductoSeleccionado = document.getElementById("detalleProductoSeleccionado");
        const lblPrecioUnitario = document.getElementById("lblPrecioUnitario");
        const lblStockDisponible = document.getElementById("lblStockDisponible");
        const lblCategoria = document.getElementById("lblCategoria");
        const tablaDetalles = document.getElementById("tablaDetalles").getElementsByTagName("tbody")[0];
        const filaVacia = document.getElementById("filaVacia");

        // Totales DOM
        const lblResumenSubtotal = document.getElementById("lblResumenSubtotal");
        const descuentoInput = document.getElementById("descuentoInput");
        const lblResumenGravable = document.getElementById("lblResumenGravable");
        const lblResumenImpuesto = document.getElementById("lblResumenImpuesto");
        const lblResumenTotal = document.getElementById("lblResumenTotal");
        
        // Formulario y Submit
        const clienteSearchInput = document.getElementById("clienteSearchInput");
        const clienteIdInput = document.getElementById("clienteIdInput");
        const clienteResults = document.getElementById("clienteResults");
        const clienteSeleccionado = document.getElementById("clienteSeleccionado");
        const metodoPagoSelect = document.getElementById("metodoPagoSelect");
        const observacionText = document.getElementById("observacionText");
        const btnGuardarVenta = document.getElementById("btnGuardarVenta");
        const errorSubmitAlert = document.getElementById("errorSubmitAlert");
        const ventaNotice = document.getElementById("ventaNotice");
        let ventaNoticeTimer = null;

        // Formatear moneda de Costa Rica (Colon)
        const formatMoneda = (valor) => {
            return new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' }).format(valor);
        };

        const normalizarTexto = (valor) => {
            return (valor || "")
                .toString()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLocaleLowerCase("es");
        };

        function limpiarClienteSeleccionado() {
            clienteIdInput.value = "";
            clienteSeleccionado.textContent = "Sin cliente seleccionado.";
        }

        function seleccionarCliente(cliente) {
            const id = cliente.id ?? cliente.Id;
            const nombre = cliente.nombreCompleto ?? cliente.NombreCompleto;
            const identificacion = cliente.identificacion ?? cliente.Identificacion;

            clienteIdInput.value = id;
            clienteSearchInput.value = `${nombre} (${identificacion})`;
            clienteSeleccionado.textContent = `Cliente seleccionado: ${nombre}`;
            clienteResults.classList.add("d-none");
            clienteResults.innerHTML = "";
        }

        function renderizarClientes(filtro) {
            const filtroNormalizado = normalizarTexto(filtro);

            if (filtroNormalizado.length < 2) {
                clienteResults.classList.add("d-none");
                clienteResults.innerHTML = "";
                return;
            }

            const resultados = clientesDisponibles
                .filter(cliente => {
                    const nombre = cliente.nombreCompleto ?? cliente.NombreCompleto;
                    const identificacion = cliente.identificacion ?? cliente.Identificacion;
                    return normalizarTexto(`${nombre} ${identificacion}`).includes(filtroNormalizado);
                })
                .slice(0, 8);

            clienteResults.innerHTML = "";

            if (resultados.length === 0) {
                const empty = document.createElement("div");
                empty.className = "vu-sale-search-empty";
                empty.textContent = "No se encontraron clientes.";
                clienteResults.appendChild(empty);
                clienteResults.classList.remove("d-none");
                return;
            }

            resultados.forEach(cliente => {
                const nombre = cliente.nombreCompleto ?? cliente.NombreCompleto;
                const identificacion = cliente.identificacion ?? cliente.Identificacion;
                const telefono = cliente.telefono ?? cliente.Telefono;
                const button = document.createElement("button");
                button.type = "button";
                button.className = "vu-sale-search-item";
                button.setAttribute("role", "option");
                button.innerHTML = `<strong>${nombre}</strong><span>${identificacion}${telefono ? ` · ${telefono}` : ""}</span>`;
                button.addEventListener("click", () => seleccionarCliente(cliente));
                clienteResults.appendChild(button);
            });

            clienteResults.classList.remove("d-none");
        }

        clienteSearchInput.addEventListener("input", () => {
            limpiarClienteSeleccionado();
            renderizarClientes(clienteSearchInput.value);
        });

        clienteSearchInput.addEventListener("focus", () => {
            renderizarClientes(clienteSearchInput.value);
        });

        document.addEventListener("click", (event) => {
            if (!event.target.closest(".vu-sale-search")) {
                clienteResults.classList.add("d-none");
            }
        });

        // Escuchar cambio en seleccion de producto
        productoSelect.addEventListener("change", () => {
            const prodId = parseInt(productoSelect.value);
            const producto = productosDisponibles.find(p => (p.id ?? p.Id) === prodId);

            if (producto) {
                const precio = producto.precio ?? producto.Precio;
                const stock = producto.cantidadDisponible ?? producto.CantidadDisponible;
                const categoria = producto.categoria ?? producto.Categoria;

                lblPrecioUnitario.textContent = formatMoneda(precio);
                lblStockDisponible.textContent = stock;
                lblCategoria.textContent = categoria;

                if (stock <= (producto.stockMinimo ?? producto.StockMinimo)) {
                    lblStockDisponible.className = "badge vu-stock-badge vu-stock-low";
                } else {
                    lblStockDisponible.className = "badge vu-stock-badge vu-stock-ok";
                }

                const productoActivo = producto.activo ?? producto.Activo;
                const puedeVenderse = productoActivo && stock > 0;

                cantidadInput.disabled = !puedeVenderse;
                cantidadInput.max = stock;
                cantidadInput.value = puedeVenderse ? 1 : 0;
                btnAgregarProducto.disabled = !puedeVenderse;
                detalleProductoSeleccionado.classList.remove("d-none");

                if (!productoActivo) {
                    mostrarAviso("Este producto está inactivo y no puede agregarse a la venta.", "warning");
                } else if (stock <= 0) {
                    mostrarAviso("Este producto no tiene existencias disponibles.", "warning");
                }
            } else {
                cantidadInput.disabled = true;
                cantidadInput.value = 1;
                btnAgregarProducto.disabled = true;
                detalleProductoSeleccionado.classList.add("d-none");
            }
        });

        // Validar cantidad ingresada en el input
        cantidadInput.addEventListener("input", () => {
            const prodId = parseInt(productoSelect.value);
            const producto = productosDisponibles.find(p => (p.id ?? p.Id) === prodId);
            if (!producto) return;

            const maxStock = producto.cantidadDisponible ?? producto.CantidadDisponible;
            let val = parseInt(cantidadInput.value);

            if (isNaN(val) || val < 1) {
                mostrarAviso("La cantidad debe ser mayor a cero.", "warning");
                cantidadInput.value = "";
                return;
            }

            if (val > maxStock) {
                mostrarAviso(`Atención: solo quedan ${maxStock} unidades disponibles en inventario.`, "warning");
                cantidadInput.value = maxStock;
            }
        });

        // Agregar producto al carrito
        btnAgregarProducto.addEventListener("click", () => {
            const prodId = parseInt(productoSelect.value);
            const producto = productosDisponibles.find(p => (p.id ?? p.Id) === prodId);
            if (!producto) return;

            const cantidadToAdd = parseInt(cantidadInput.value);
            const stockMax = producto.cantidadDisponible ?? producto.CantidadDisponible;
            const productoActivo = producto.activo ?? producto.Activo;

            if (!productoActivo) {
                mostrarAviso("Este producto está inactivo y no puede agregarse a la venta.", "warning");
                return;
            }

            if (stockMax <= 0) {
                mostrarAviso("Este producto no tiene existencias disponibles.", "warning");
                return;
            }

            if (Number.isNaN(cantidadToAdd) || cantidadToAdd <= 0) {
                mostrarAviso("La cantidad debe ser mayor a cero.", "warning");
                cantidadInput.focus();
                return;
            }

            if (cantidadToAdd > stockMax) {
                mostrarAviso(`Stock insuficiente. Disponible: ${stockMax}, solicitado: ${cantidadToAdd}.`, "warning");
                cantidadInput.focus();
                return;
            }
            
            // Verificar si ya existe en el carrito
            const itemExistente = carrito.find(item => item.productoId === prodId);
            if (itemExistente) {
                const nuevaCantidad = itemExistente.cantidad + cantidadToAdd;
                if (nuevaCantidad > stockMax) {
                    mostrarAviso(`No puedes agregar esa cantidad. Ya tienes ${itemExistente.cantidad} en el carrito y el stock máximo es ${stockMax}.`, "warning");
                    return;
                }
                itemExistente.cantidad = nuevaCantidad;
            } else {
                carrito.push({
                    productoId: prodId,
                    nombre: producto.nombre ?? producto.Nombre,
                    talla: producto.talla ?? producto.Talla,
                    color: producto.color ?? producto.Color,
                    precioUnitario: producto.precio ?? producto.Precio,
                    cantidad: cantidadToAdd,
                    stockMax: stockMax
                });
            }

            // Resetear seleccionador
            productoSelect.value = "";
            cantidadInput.disabled = true;
            cantidadInput.value = 1;
            btnAgregarProducto.disabled = true;
            detalleProductoSeleccionado.classList.add("d-none");

            dibujarCarrito();
        });

        // Dibujar el carrito en la tabla
        function dibujarCarrito() {
            // Limpiar tabla exceptuando encabezado
            while (tablaDetalles.rows.length > 0) {
                tablaDetalles.deleteRow(0);
            }

            if (carrito.length === 0) {
                filaVacia.classList.remove("d-none");
                tablaDetalles.appendChild(filaVacia);
                btnGuardarVenta.disabled = true;
                actualizarTotales();
                return;
            }

            filaVacia.classList.add("d-none");

            carrito.forEach((item, index) => {
                const tr = document.createElement("tr");

                // Nombre producto
                const tdNombre = document.createElement("td");
                tdNombre.className = "ps-3";
                tdNombre.innerHTML = `<strong>${item.nombre}</strong>`;
                tr.appendChild(tdNombre);

                // Talla / Color
                const tdDetalle = document.createElement("td");
                tdDetalle.className = "text-center";
                tdDetalle.textContent = `${item.talla} / ${item.color}`;
                tr.appendChild(tdDetalle);

                // Precio Unitario
                const tdPrecio = document.createElement("td");
                tdPrecio.className = "text-end";
                tdPrecio.textContent = formatMoneda(item.precioUnitario);
                tr.appendChild(tdPrecio);

                // Cantidad Selector
                const tdCantidad = document.createElement("td");
                tdCantidad.className = "text-center";
                
                const divGroup = document.createElement("div");
                divGroup.className = "input-group input-group-sm justify-content-center";
                divGroup.style.maxWidth = "110px";
                divGroup.style.margin = "0 auto";

                const btnMinus = document.createElement("button");
                btnMinus.type = "button";
                btnMinus.className = "btn btn-outline-secondary btn-sm";
                btnMinus.textContent = "-";
                btnMinus.addEventListener("click", () => modificarCantidad(index, -1));

                const inputQty = document.createElement("input");
                inputQty.type = "text";
                inputQty.className = "form-control text-center";
                inputQty.value = item.cantidad;
                inputQty.readOnly = true;

                const btnPlus = document.createElement("button");
                btnPlus.type = "button";
                btnPlus.className = "btn btn-outline-secondary btn-sm";
                btnPlus.textContent = "+";
                btnPlus.addEventListener("click", () => modificarCantidad(index, 1));

                divGroup.appendChild(btnMinus);
                divGroup.appendChild(inputQty);
                divGroup.appendChild(btnPlus);
                tdCantidad.appendChild(divGroup);
                tr.appendChild(tdCantidad);

                // Subtotal Item
                const tdSubtotal = document.createElement("td");
                tdSubtotal.className = "text-end";
                tdSubtotal.textContent = formatMoneda(item.precioUnitario * item.cantidad);
                tr.appendChild(tdSubtotal);

                // Boton quitar
                const tdAcciones = document.createElement("td");
                tdAcciones.className = "text-center";
                const btnQuitar = document.createElement("button");
                btnQuitar.type = "button";
                btnQuitar.className = "btn btn-danger btn-sm vu-icon-btn";
                btnQuitar.innerHTML = `<svg viewBox="0 0 24 24" style="width: 14px; height: 14px;" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>`;
                btnQuitar.addEventListener("click", () => quitarDelCarrito(index));
                tdAcciones.appendChild(btnQuitar);
                tr.appendChild(tdAcciones);

                tablaDetalles.appendChild(tr);
            });

            btnGuardarVenta.disabled = false;
            actualizarTotales();
        }

        // Modificar cantidad desde la tabla
        function modificarCantidad(index, offset) {
            const item = carrito[index];
            const nuevaCant = item.cantidad + offset;

            if (nuevaCant < 1) {
                quitarDelCarrito(index);
                return;
            }

            if (nuevaCant > item.stockMax) {
                mostrarAviso(`No es posible agregar más de este producto. El stock máximo disponible es ${item.stockMax}.`, "warning");
                return;
            }

            item.cantidad = nuevaCant;
            dibujarCarrito();
        }

        // Eliminar elemento
        function quitarDelCarrito(index) {
            carrito.splice(index, 1);
            dibujarCarrito();
        }

        // Calcular Totales
        function actualizarTotales() {
            let subtotal = 0;
            carrito.forEach(item => {
                subtotal += item.precioUnitario * item.cantidad;
            });

            // Leer descuento
            let descuento = parseFloat(descuentoInput.value);
            if (isNaN(descuento) || descuento < 0) {
                descuentoInput.value = 0;
                descuento = 0;
            }

            if (descuento > subtotal) {
                descuento = subtotal;
                descuentoInput.value = subtotal;
            }

            const gravable = subtotal - descuento;
            const impuesto = gravable * 0.13; // IVA 13% Costa Rica
            const total = gravable + impuesto;

            lblResumenSubtotal.textContent = formatMoneda(subtotal);
            lblResumenGravable.textContent = formatMoneda(gravable);
            lblResumenImpuesto.textContent = formatMoneda(impuesto);
            lblResumenTotal.textContent = formatMoneda(total);

            // Almacenar valores computados en atributos para recuperarlos al guardar
            lblResumenSubtotal.dataset.valor = subtotal;
            descuentoInput.dataset.valor = descuento;
            lblResumenImpuesto.dataset.valor = impuesto;
            lblResumenTotal.dataset.valor = total;
        }

        descuentoInput.addEventListener("input", actualizarTotales);

        function mostrarAviso(mensaje, tipo = "danger", destino = ventaNotice) {
            if (!destino) {
                return;
            }

            window.clearTimeout(ventaNoticeTimer);
            destino.textContent = mensaje;
            destino.classList.remove("d-none", "vu-sale-notice-danger", "vu-sale-notice-warning", "vu-sale-notice-dismissing");
            destino.classList.add(tipo === "warning" ? "vu-sale-notice-warning" : "vu-sale-notice-danger");
            destino.scrollIntoView({ behavior: "smooth", block: "nearest" });

            ventaNoticeTimer = window.setTimeout(() => {
                destino.classList.add("vu-sale-notice-dismissing");
                window.setTimeout(() => {
                    destino.classList.add("d-none");
                    destino.classList.remove("vu-sale-notice-dismissing");
                    destino.textContent = "";
                }, 240);
            }, 3000);
        }

        function mostrarErrorSubmit(mensaje) {
            mostrarAviso(mensaje, "danger", errorSubmitAlert);
        }

        // Guardar Venta
        btnGuardarVenta.addEventListener("click", async () => {
            const clienteId = parseInt(clienteIdInput.value);
            const metodoPagoId = parseInt(metodoPagoSelect.value);
            const observacion = observacionText.value;

            if (!clienteId || Number.isNaN(clienteId)) {
                mostrarAviso("Debes seleccionar un cliente.", "warning");
                clienteSearchInput.focus();
                return;
            }

            if (!metodoPagoId) {
                mostrarAviso("Debes seleccionar un método de pago.", "warning");
                metodoPagoSelect.focus();
                return;
            }

            if (carrito.length === 0) {
                mostrarAviso("El detalle de la venta no puede estar vacío.", "warning");
                return;
            }

            btnGuardarVenta.disabled = true;
            btnGuardarVenta.textContent = "Registrando...";
            errorSubmitAlert.classList.add("d-none");

            // Construir payload
            const payload = {
                clienteId: clienteId,
                metodoPagoId: metodoPagoId,
                descuento: parseFloat(descuentoInput.dataset.valor || 0),
                impuesto: parseFloat(lblResumenImpuesto.dataset.valor || 0),
                observacion: observacion,
                detalles: carrito.map(item => ({
                    productoId: item.productoId,
                    cantidad: item.cantidad,
                    precioUnitario: item.precioUnitario
                }))
            };

            // Obtener Token CSRF
            const csrfToken = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch('/Venta/Crear', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': csrfToken
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (response.ok && data.esExitoso) {
                    // Redireccionar con exito
                    window.location.href = '/Venta';
                } else {
                    mostrarErrorSubmit(data.mensaje || "Error desconocido al registrar la venta.");
                    btnGuardarVenta.disabled = false;
                    btnGuardarVenta.textContent = "Registrar Venta";
                }
            } catch (err) {
                mostrarErrorSubmit("Error de red o conexión al servidor. Intenta nuevamente.");
                btnGuardarVenta.disabled = false;
                btnGuardarVenta.textContent = "Registrar Venta";
                console.error(err);
            }
        });
    </script>
}

