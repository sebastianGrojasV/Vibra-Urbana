@{
    ViewData["Title"] = "Login";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="vu-form-shell">
                <p class="vu-eyebrow">Acceso</p>
                <h1>Iniciar sesion</h1>
                <form>
                    <div class="mb-3">
                        <label class="form-label" for="email">Correo electronico</label>
                        <input class="form-control" id="email" name="email" type="email" autocomplete="email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Contrasena</label>
                        <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" />
                    </div>
                    <button class="btn btn-dark w-100" type="button">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</section>
