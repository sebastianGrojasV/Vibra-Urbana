@model VibraUrbana.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="vu-auth-page">
    <div class="container">
        <div class="row min-vh-75 align-items-center justify-content-center g-4">
            <div class="col-lg-6">
                <div class="vu-auth-copy">
                    <p class="vu-eyebrow">Vibra Urbana</p>
                    <h1>Gestión comercial para una tienda con estilo propio.</h1>
                    <p>
                        Acceso inicial del sistema para administración, ventas, inventario y consulta operativa.
                    </p>
                    <div class="vu-auth-pills">
                        <span>Usuarios</span>
                        <span>Inventario</span>
                        <span>Ventas</span>
                        <span>Reportes</span>
                    </div>
                </div>
            </div>

            <div class="col-md-8 col-lg-5">
                <div class="vu-auth-card">
                    <div class="text-center mb-4">
                        <img src="~/img/logo-vibra-urbana.jpeg" alt="Vibra Urbana" class="vu-auth-card-logo" />
                        <h2>Iniciar sesión</h2>
                        <p>Ingresa con tu cuenta asignada para continuar.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden" />

                        @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="alert alert-danger" role="alert">
                                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control form-control-lg" autocomplete="email" placeholder="usuario@vibraurbana.com" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Ingresa tu contraseña" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="form-check">
                                <input asp-for="Recordarme" class="form-check-input" />
                                <label asp-for="Recordarme" class="form-check-label"></label>
                            </div>
                            <a class="vu-text-link" asp-controller="Account" asp-action="RecuperarAcceso">Olvidé mi contraseña</a>
                        </div>
                        <button class="btn btn-primary btn-lg w-100" type="submit">Iniciar sesión</button>
                        <a class="btn btn-outline-primary btn-lg w-100 mt-2" asp-controller="Home" asp-action="Index">Volver al inicio</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
