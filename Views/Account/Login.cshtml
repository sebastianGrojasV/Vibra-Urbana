@{
    ViewData["Title"] = "Iniciar sesion";
}

<section class="vu-auth-page">
    <div class="container">
        <div class="row min-vh-75 align-items-center justify-content-center g-4">
            <div class="col-lg-6">
                <div class="vu-auth-copy">
                    <p class="vu-eyebrow">Vibra Urbana</p>
                    <h1>Gestion comercial para una tienda con estilo propio.</h1>
                    <p>
                        Acceso inicial del sistema para administracion, ventas, inventario y consulta operativa.
                    </p>
                    <div class="vu-auth-pills">
                        <span>Usuarios</span>
                        <span>Inventario</span>
                        <span>Ventas</span>
                        <span>Reportes</span>
                    </div>
                </div>
            </div>

            <div class="col-md-8 col-lg-5">
                <div class="vu-auth-card">
                    <div class="text-center mb-4">
                        <div class="vu-brand-mark">VU</div>
                        <h2>Iniciar sesion</h2>
                        <p>Ingresa con tu cuenta asignada para continuar.</p>
                    </div>

                    <form>
                        <div class="mb-3">
                            <label class="form-label" for="correo">Correo electronico</label>
                            <input class="form-control form-control-lg" id="correo" name="correo" type="email" autocomplete="email" placeholder="usuario@vibraurbana.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="password">Contrasena</label>
                            <input class="form-control form-control-lg" id="password" name="password" type="password" autocomplete="current-password" placeholder="Ingresa tu contrasena" />
                        </div>
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="form-check">
                                <input class="form-check-input" id="recordarme" type="checkbox" />
                                <label class="form-check-label" for="recordarme">Recordarme</label>
                            </div>
                            <a class="vu-text-link" asp-controller="Home" asp-action="Index">Volver al inicio</a>
                        </div>
                        <button class="btn btn-primary btn-lg w-100" type="button">Entrar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
