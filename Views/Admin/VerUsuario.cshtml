@model VibraUrbana.ViewModels.UsuarioDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Usuario";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <aside class="col-lg-3 col-xl-2 vu-admin-sidebar">
                <div class="vu-sidebar-brand">Vibra Urbana</div>
                <nav class="vu-sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index">Panel inicial</a>
                    <a class="active" asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <a asp-controller="Rol" asp-action="Index">Roles</a>
                    <a asp-controller="Cliente" asp-action="Index">Clientes</a>
                    <a asp-controller="Producto" asp-action="Index">Productos</a>
                    <a asp-controller="Inventario" asp-action="Index">Inventario</a>
                    <a asp-controller="Venta" asp-action="Index">Ventas</a>
                    <a asp-controller="Factura" asp-action="Index">Facturación</a>
                    <a asp-controller="Reporte" asp-action="Index">Reportes</a>
                    <a asp-controller="Pedido" asp-action="Index">Pedidos</a>
                </nav>
            </aside>

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Detalle de usuario</h1>
                        <p>Información registrada del usuario interno.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" asp-controller="Admin" asp-action="ModificarUsuario" asp-route-id="@Model.Id">Modificar</a>
                        <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="RestablecerPasswordUsuario" asp-route-id="@Model.Id">Restablecer contraseña</a>
                        <form asp-controller="Admin"
                              asp-action="ConfirmarCambiarEstadoUsuario"
                              method="post"
                              class="d-inline"
                              data-vu-confirm
                              data-vu-confirm-title="@(Model.Activo ? "Desactivar usuario" : "Activar usuario")"
                              data-vu-confirm-message="@(Model.Activo ? $"¿Deseas desactivar a {Model.NombreCompleto}?" : $"¿Deseas activar a {Model.NombreCompleto}?")"
                              data-vu-confirm-action="@(Model.Activo ? "Desactivar" : "Activar")">
                            @Html.AntiForgeryToken()
                            <input name="id" type="hidden" value="@Model.Id" />
                            <input name="active" type="hidden" value="@(Model.Activo ? "false" : "true")" />
                            <button class="btn @(Model.Activo ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                @(Model.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                        <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Usuarios">Volver al listado</a>
                    </div>
                </div>

                <div class="vu-panel">
                    <dl class="row mb-0">
                        <dt class="col-md-3">Nombre</dt>
                        <dd class="col-md-9">@Model.NombreCompleto</dd>

                        <dt class="col-md-3">Cédula</dt>
                        <dd class="col-md-9">@Model.Cedula</dd>

                        <dt class="col-md-3">Correo</dt>
                        <dd class="col-md-9">@Model.Correo</dd>

                        <dt class="col-md-3">Rol</dt>
                        <dd class="col-md-9">@Model.Rol</dd>

                        <dt class="col-md-3">Estado</dt>
                        <dd class="col-md-9">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </dd>

                        <dt class="col-md-3">Fecha de creación</dt>
                        <dd class="col-md-9">@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</section>
