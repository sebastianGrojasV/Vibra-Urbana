@model VibraUrbana.ViewModels.UsuarioDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Usuario";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            @await Html.PartialAsync("_Sidebar")

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">AdministraciÃ³n</p>
                        <h1>Detalle de usuario</h1>
                        <p>InformaciÃ³n registrada del usuario interno.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" asp-controller="Admin" asp-action="ModificarUsuario" asp-route-id="@Model.Id">Modificar</a>
                        <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="RestablecerPasswordUsuario" asp-route-id="@Model.Id">Restablecer contraseÃ±a</a>
                        <form asp-controller="Admin"
                              asp-action="ConfirmarCambiarEstadoUsuario"
                              method="post"
                              class="d-inline"
                              data-vu-confirm
                              data-vu-confirm-title="@(Model.Activo ? "Desactivar usuario" : "Activar usuario")"
                              data-vu-confirm-message="@(Model.Activo ? $"Â¿Deseas desactivar a {Model.NombreCompleto}?" : $"Â¿Deseas activar a {Model.NombreCompleto}?")"
                              data-vu-confirm-action="@(Model.Activo ? "Desactivar" : "Activar")">
                            @Html.AntiForgeryToken()
                            <input name="id" type="hidden" value="@Model.Id" />
                            <input name="active" type="hidden" value="@(Model.Activo ? "false" : "true")" />
                            <button class="btn @(Model.Activo ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                @(Model.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                        <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Usuarios">Volver al listado</a>
                    </div>
                </div>

                <div class="vu-panel">
                    <dl class="row mb-0">
                        <dt class="col-md-3">Nombre</dt>
                        <dd class="col-md-9">@Model.NombreCompleto</dd>

                        <dt class="col-md-3">CÃ©dula</dt>
                        <dd class="col-md-9">@Model.Cedula</dd>

                        <dt class="col-md-3">Correo</dt>
                        <dd class="col-md-9">@Model.Correo</dd>

                        <dt class="col-md-3">Rol</dt>
                        <dd class="col-md-9">@Model.Rol</dd>

                        <dt class="col-md-3">Estado</dt>
                        <dd class="col-md-9">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </dd>

                        <dt class="col-md-3">Fecha de creaciÃ³n</dt>
                        <dd class="col-md-9">@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</section>

