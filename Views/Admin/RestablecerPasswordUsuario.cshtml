@model VibraUrbana.ViewModels.RestablecerPasswordUsuarioViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <aside class="col-lg-3 col-xl-2 vu-admin-sidebar">
                <div class="vu-sidebar-brand">Vibra Urbana</div>
                <nav class="vu-sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index">Panel inicial</a>
                    <a class="active" asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <a asp-controller="Rol" asp-action="Index">Roles</a>
                    <a asp-controller="Cliente" asp-action="Index">Clientes</a>
                    <a asp-controller="Producto" asp-action="Index">Productos</a>
                    <a asp-controller="Inventario" asp-action="Index">Inventario</a>
                    <a asp-controller="Venta" asp-action="Index">Ventas</a>
                    <a asp-controller="Factura" asp-action="Index">Facturación</a>
                    <a asp-controller="Reporte" asp-action="Index">Reportes</a>
                    <a asp-controller="Pedido" asp-action="Index">Pedidos</a>
                </nav>
            </aside>

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Restablecer contraseña</h1>
                        <p>Define una nueva contraseña temporal para el usuario.</p>
                    </div>
                    <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="VerUsuario" asp-route-id="@Model.Id">Volver al detalle</a>
                </div>

                <div class="row g-4">
                    <div class="col-xl-8">
                        <div class="vu-panel">
                            @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                            {
                                <div class="alert alert-danger" role="alert">
                                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                    {
                                        <div>@error.ErrorMessage</div>
                                    }
                                </div>
                            }

                            <form asp-controller="Admin" asp-action="RestablecerPasswordUsuario" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <input asp-for="Id" type="hidden" />
                                <input asp-for="NombreCompleto" type="hidden" />
                                <input asp-for="Correo" type="hidden" />

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Usuario</label>
                                        <input class="form-control" value="@Model.NombreCompleto" disabled />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Correo</label>
                                        <input class="form-control" value="@Model.Correo" disabled />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NuevaPassword" class="form-label"></label>
                                        <input asp-for="NuevaPassword" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                                        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mt-4">
                                    <button class="btn btn-primary" type="submit">Restablecer contraseña</button>
                                    <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="VerUsuario" asp-route-id="@Model.Id">Cancelar</a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="col-xl-4">
                        <div class="vu-panel">
                            <h2>Seguridad</h2>
                            <ul class="vu-status-list">
                                <li><span></span> La contraseña se guarda como hash</li>
                                <li><span></span> No se muestran contraseñas anteriores</li>
                                <li><span></span> Solo administradores pueden restablecer acceso</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
