@model VibraUrbana.ViewModels.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Registrar Usuario";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            @await Html.PartialAsync("_Sidebar")

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">AdministraciÃ³n</p>
                        <h1>Registrar usuario</h1>
                        <p>Crea usuarios internos activos para empleados autorizados.</p>
                    </div>
                    <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Usuarios">Volver al listado</a>
                </div>

                <div class="row g-4">
                    <div class="col-xl-8">
                        <div class="vu-panel">
                            @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                            {
                                <div class="alert alert-danger" role="alert">
                                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                    {
                                        <div>@error.ErrorMessage</div>
                                    }
                                </div>
                            }

                            <form asp-controller="Admin" asp-action="CrearUsuario" method="post" novalidate>
                                @Html.AntiForgeryToken()

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="Cedula" class="form-label"></label>
                                        <input asp-for="Cedula" class="form-control" autocomplete="off" />
                                        <span asp-validation-for="Cedula" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="NombreCompleto" class="form-label"></label>
                                        <input asp-for="NombreCompleto" class="form-control" autocomplete="name" />
                                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Correo" class="form-label"></label>
                                        <input asp-for="Correo" class="form-control" autocomplete="email" />
                                        <span asp-validation-for="Correo" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="RolId" class="form-label"></label>
                                        <select asp-for="RolId" asp-items="Model.Roles" class="form-select">
                                            <option value="">Selecciona un rol</option>
                                        </select>
                                        <span asp-validation-for="RolId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Password" class="form-label"></label>
                                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mt-4">
                                    <button class="btn btn-primary" type="submit">Guardar</button>
                                    <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="CrearUsuario">Limpiar</a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="col-xl-4">
                        <div class="vu-panel">
                            <h2>Condiciones</h2>
                            <ul class="vu-status-list">
                                <li><span></span> CÃ©dula y correo deben ser Ãºnicos</li>
                                <li><span></span> El usuario queda activo por defecto</li>
                                <li><span></span> La contraseÃ±a se guarda como hash</li>
                                <li><span></span> Solo administradores pueden registrar usuarios</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

