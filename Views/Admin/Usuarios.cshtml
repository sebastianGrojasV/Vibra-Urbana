@model IReadOnlyList<VibraUrbana.ViewModels.UsuarioListadoItemViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <aside class="col-lg-3 col-xl-2 vu-admin-sidebar">
                <div class="vu-sidebar-brand">Vibra Urbana</div>
                <nav class="vu-sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index">Panel inicial</a>
                    <a class="active" asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <a asp-controller="Rol" asp-action="Index">Roles</a>
                    <a asp-controller="Cliente" asp-action="Index">Clientes</a>
                    <a asp-controller="Producto" asp-action="Index">Productos</a>
                    <a asp-controller="Inventario" asp-action="Index">Inventario</a>
                    <a asp-controller="Venta" asp-action="Index">Ventas</a>
                    <a asp-controller="Factura" asp-action="Index">Facturación</a>
                    <a asp-controller="Reporte" asp-action="Index">Reportes</a>
                    <a asp-controller="Pedido" asp-action="Index">Pedidos</a>
                </nav>
            </aside>

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Usuarios</h1>
                        <p>Consulta los usuarios internos registrados y sus accesos.</p>
                    </div>
                    <a class="btn btn-primary" asp-controller="Admin" asp-action="CrearUsuario">Registrar usuario</a>
                </div>

                <div class="vu-panel">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            No existen usuarios registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle vu-data-table">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Cédula</th>
                                        <th>Correo</th>
                                        <th>Rol</th>
                                        <th>Estado</th>
                                        <th class="text-end vu-actions-column">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in Model)
                                    {
                                        <tr>
                                            <td>@usuario.NombreCompleto</td>
                                            <td>@usuario.Cedula</td>
                                            <td>@usuario.Correo</td>
                                            <td>@usuario.Rol</td>
                                            <td>
                                                @if (usuario.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="vu-actions">
                                                    <a class="btn btn-sm vu-icon-btn vu-icon-view" asp-controller="Admin" asp-action="VerUsuario" asp-route-id="@usuario.Id" title="Ver" aria-label="Ver usuario">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                    </a>
                                                    <a class="btn btn-sm vu-icon-btn vu-icon-edit" asp-controller="Admin" asp-action="ModificarUsuario" asp-route-id="@usuario.Id" title="Modificar" aria-label="Modificar usuario">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"></path></svg>
                                                    </a>
                                                    <a class="btn btn-sm vu-icon-btn vu-icon-reset" asp-controller="Admin" asp-action="RestablecerPasswordUsuario" asp-route-id="@usuario.Id" title="Restablecer contraseña" aria-label="Restablecer contraseña">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"></circle><path d="M12 12l8-8"></path><path d="M16 4h4v4"></path></svg>
                                                    </a>
                                                    <form asp-controller="Admin"
                                                          asp-action="ConfirmarCambiarEstadoUsuario"
                                                          method="post"
                                                          class="d-inline"
                                                          data-vu-confirm
                                                          data-vu-confirm-title="@(usuario.Activo ? "Desactivar usuario" : "Activar usuario")"
                                                          data-vu-confirm-message="@(usuario.Activo ? $"¿Deseas desactivar a {usuario.NombreCompleto}?" : $"¿Deseas activar a {usuario.NombreCompleto}?")"
                                                          data-vu-confirm-action="@(usuario.Activo ? "Desactivar" : "Activar")">
                                                        @Html.AntiForgeryToken()
                                                        <input name="id" type="hidden" value="@usuario.Id" />
                                                        <input name="active" type="hidden" value="@(!usuario.Activo).ToString().ToLowerInvariant()" />
                                                        <button class="btn btn-sm vu-icon-btn @(usuario.Activo ? "vu-icon-disable" : "vu-icon-enable")" type="submit" title="@(usuario.Activo ? "Desactivar" : "Activar")" aria-label="@(usuario.Activo ? "Desactivar usuario" : "Activar usuario")">
                                                            @if (usuario.Activo)
                                                            {
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.4 6.6a9 9 0 1 1-12.8 0"></path><path d="M12 2v10"></path></svg>
                                                            }
                                                            else
                                                            {
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                                                            }
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
