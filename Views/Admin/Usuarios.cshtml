@model IReadOnlyList<VibraUrbana.ViewModels.UsuarioListadoItemViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<section class="vu-admin-shell">
    <div class="container-fluid">
        <div class="row g-0">
            <aside class="col-lg-3 col-xl-2 vu-admin-sidebar">
                <div class="vu-sidebar-brand">Vibra Urbana</div>
                <nav class="vu-sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index">Panel inicial</a>
                    <a class="active" asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <a asp-controller="Rol" asp-action="Index">Roles</a>
                    <a asp-controller="Cliente" asp-action="Index">Clientes</a>
                    <a asp-controller="Producto" asp-action="Index">Productos</a>
                    <a asp-controller="Inventario" asp-action="Index">Inventario</a>
                    <a asp-controller="Venta" asp-action="Index">Ventas</a>
                    <a asp-controller="Factura" asp-action="Index">Facturación</a>
                    <a asp-controller="Reporte" asp-action="Index">Reportes</a>
                    <a asp-controller="Pedido" asp-action="Index">Pedidos</a>
                </nav>
            </aside>

            <div class="col-lg-9 col-xl-10 vu-admin-content">
                <div class="vu-admin-header">
                    <div>
                        <p class="vu-eyebrow">Administración</p>
                        <h1>Usuarios</h1>
                        <p>Consulta los usuarios internos registrados y sus accesos.</p>
                    </div>
                    <a class="btn btn-primary" asp-controller="Admin" asp-action="CrearUsuario">Registrar usuario</a>
                </div>

                <div class="vu-panel">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">@successMessage</div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            No existen usuarios registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Cédula</th>
                                        <th>Correo</th>
                                        <th>Rol</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in Model)
                                    {
                                        <tr>
                                            <td>@usuario.NombreCompleto</td>
                                            <td>@usuario.Cedula</td>
                                            <td>@usuario.Correo</td>
                                            <td>@usuario.Rol</td>
                                            <td>
                                                @if (usuario.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="VerUsuario" asp-route-id="@usuario.Id">Ver</a>
                                                <a class="btn btn-sm btn-primary" asp-controller="Admin" asp-action="ModificarUsuario" asp-route-id="@usuario.Id">Modificar</a>
                                                <a class="btn btn-sm @(usuario.Activo ? "btn-outline-danger" : "btn-outline-success")" asp-controller="Admin" asp-action="CambiarEstadoUsuario" asp-route-id="@usuario.Id">
                                                    @(usuario.Activo ? "Desactivar" : "Activar")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
