@inject VibraUrbana.Services.INavigationMenuService NavigationMenuService

@{
    var menuItems = await NavigationMenuService.GetItemsAsync(User);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vibra Urbana</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg vu-navbar">
            <div class="container">
                <a class="navbar-brand vu-navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo-vibra-urbana.jpeg" alt="Vibra Urbana" class="vu-nav-logo" />
                    <span>Vibra Urbana</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @foreach (var item in menuItems)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="@item.Controller" asp-action="@item.Action">@item.Texto</a>
                            </li>
                        }
                        <li class="nav-item">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="vu-user-area">
                                    <span class="vu-user-chip" title="Usuario activo">
                                        <span class="vu-user-avatar" aria-hidden="true">@((User.Identity.Name ?? "U")[..1].ToUpperInvariant())</span>
                                        <span class="vu-user-meta">
                                            <strong>@User.Identity.Name</strong>
                                            <small>Usuario del sistema</small>
                                        </span>
                                    </span>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-light" type="submit">Cerrar sesión</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="vu-confirm-frame" data-vu-confirm-frame hidden>
        <div class="vu-confirm-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0Z"></path></svg>
        </div>
        <div class="vu-confirm-copy">
            <strong data-vu-confirm-title>Confirmar acción</strong>
            <span data-vu-confirm-message>Confirma para continuar.</span>
        </div>
        <div class="vu-confirm-actions">
            <button class="btn btn-sm btn-primary" type="button" data-vu-confirm-submit>Confirmar</button>
            <button class="btn btn-sm btn-outline-primary" type="button" data-vu-confirm-cancel>Cancelar</button>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="vu-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 Vibra Urbana</span>
            <span>Estructura base ASP.NET Core MVC</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/scripts.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
